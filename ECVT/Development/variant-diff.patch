-void handleSerialCommands() {
-    if (!Serial) {
-        return;
-    }
-
-    while (Serial.available() > 0) {
-        const char command = Serial.read();
-
-        if (
-            command == '\n' ||
-            command == '\r' ||
-            command == ' ' ||
-            command == '\t'
-        ) {
-            continue;
-        }
-
-        switch (command) {
-            case 'h':
-            case 'H':
-                printTerminalHelp();
-                break;
-
-            case 's':
-            case 'S':
-                printOneShotStatus();
-                break;
-
-            case 't':
-            case 'T':
-                terminal.serialTelemetryEnabled =
-                    !terminal.serialTelemetryEnabled;
-
-                Serial.print(
-                    "Periodic serial telemetry: "
-                );
-
-                Serial.println(
-                    terminal.serialTelemetryEnabled
-                        ? "ENABLED"
-                        : "DISABLED"
-                );
-
-                break;
-
-            case 'f':
-            case 'F':
-                pulseMotor(
-                    config.pwmForwardStart,
-                    "FORWARD"
-                );
-                break;
-
-            case 'r':
-            case 'R':
-                pulseMotor(
-                    config.pwmReverseStart,
-                    "REVERSE"
-                );
-                break;
-
-            case 'a':
-            case 'A':
-                terminal.automaticControlArmed = true;
-
-                Serial.println();
-                Serial.println(
-                    "WARNING: AUTOMATIC CONTROL ARMED."
-                );
-
-                Serial.println(
-                    "PWM will now follow the RPM control calculation."
-                );
-
-                Serial.println(
-                    "Type 'n' immediately to return to neutral."
-                );
-
-                Serial.println();
-                break;
-
-            case 'd':
-            case 'D':
-                terminal.automaticControlArmed = false;
-
-                forceNeutral();
-
-                Serial.println(
-                    "Automatic control DISARMED."
-                );
-
-                Serial.println(
-                    "PWM forced to neutral."
-                );
-
-                break;
-
-            case 'n':
-            case 'N':
-                terminal.automaticControlArmed = false;
-                terminal.manualPulseActive = false;
-
-                forceNeutral();
-
-                Serial.println(
-                    "EMERGENCY NEUTRAL COMMAND APPLIED."
-                );
-
-                Serial.println(
-                    "Automatic control is DISARMED."
-                );
-
-                break;
-
-            case 'c':
-            case 'C':
-                sendTcuTelemetry(
-                    lastSensors,
-                    lastControl.calculatedPwm,
-                    true
-                );
-
-                break;
-
-            case 'p':
-            case 'P':
-                printConfigSummary();
-                break;
-
-            case 'm':
-            case 'M':
-                printMotecData();
-                break;
-
-            default:
-                Serial.print(
-                    "Unknown command: "
-                );
-
-                Serial.println(command);
-
-                Serial.println(
-                    "Type 'h' for the command list."
-                );
-
-                break;
-        }
-    }
-}
